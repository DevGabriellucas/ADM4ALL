# ADM4All - exemplo para deploy. Nao coloque valores reais no repositorio.

POSTGRES_USER=adm4all
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=adm4all

POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
ADMINER_PORT=8080

DATABASE_URL=postgresql://adm4all:troque_esta_senha@db:5432/adm4all

# Dominios publicos finais do deploy.
#
# Precisam ser HTTPS: o cookie de sessao sai com a flag `Secure`, e o navegador
# descarta cookie `Secure` vindo de http:// em qualquer host que nao seja
# localhost. Em http o login responde 200 e a pessoa volta para a tela de
# login, sem mensagem de erro nenhuma.
FRONTEND_URL=https://app.seu-dominio.edu.br
NEXT_PUBLIC_API_URL=https://api.seu-dominio.edu.br

# Endereco usado SO de dentro da rede do Docker, pelo lado servidor do Next.
# Manter o nome do servico: apontar para o dominio publico obriga o container a
# sair para a internet e voltar, e quebra em servidor que nao resolve o proprio
# dominio de dentro.
API_INTERNAL_URL=http://backend:8000

# Gere valores longos e exclusivos para producao:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque_por_um_segredo_com_32_ou_mais_caracteres

# Segredo do HMAC que protege os CPFs da tabela `cpfs_bloqueados`.
# O docker-compose tem um valor padrao de DESENVOLVIMENTO: sem preencher esta
# linha, producao roda com um segredo que esta publicado no repositorio.
# Trocar depois invalida os bloqueios ja gravados, sem volta — o CPF de origem
# nao existe mais em lugar nenhum, de proposito.
CPF_HASH_SECRET=troque_por_um_segredo_com_32_ou_mais_caracteres

# E-mail de envio. Para Gmail, gere uma SENHA DE APLICATIVO em
# https://myaccount.google.com/apppasswords (16 letras minusculas).
# A senha da conta nao funciona no SMTP do Gmail.
GMAIL_USER=
GMAIL_APP_PASSWORD=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM_NAME=ADM Para Todos
EMAIL_FROM=conta-de-envio@seu-dominio.edu.br
EMAIL_TLS_REJECT_UNAUTHORIZED=true
EXPOSE_ACTIVATION_LINK=false

# Em producao, aponte para volumes persistentes.
UPLOADS_DIR=/usr/src/app/uploads
STORAGE_DIR=/usr/src/app/storage
