# ADM4All - variaveis usadas pelo docker-compose.yml da raiz

POSTGRES_USER=adm4all
POSTGRES_PASSWORD=adm4all_dev
POSTGRES_DB=adm4all

POSTGRES_PORT=5432
ADMINER_PORT=8080

# Use localhost quando o backend roda fora do Docker.
DATABASE_URL=postgresql://adm4all:adm4all_dev@localhost:5432/adm4all

# Usado pelo CORS e pelo link de recuperacao de senha.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Usado para assinar os tokens de login. Troque em producao.
JWT_SECRET=adm4all_dev_secret_change_me

# Legado: ainda protege algumas rotas administrativas de alunos no MVP.
ADMIN_API_KEY=adm4all_dev_key
