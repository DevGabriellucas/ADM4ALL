# =====================================================================
#  ADM4All — Variáveis de ambiente do banco de dados
#  Copie este arquivo para `.env` e ajuste se necessário:
#      cp .env.example .env
#  O .env é lido automaticamente pelo docker compose.
# =====================================================================

# Credenciais e nome do banco (usados pelo container Postgres)
POSTGRES_USER=adm4all
POSTGRES_PASSWORD=adm4all_dev
POSTGRES_DB=adm4all

# Portas expostas no host
POSTGRES_PORT=5432
ADMINER_PORT=8080

# String de conexão pronta para o back-end (driver pg / ORM)
# Host "localhost" quando o back roda fora do Docker.
DATABASE_URL=postgresql://adm4all:adm4all_dev@localhost:5432/adm4all
